# Only for local development. Do not copy production data into the local database.
APP_ENV=local
AUTH_MODE=local
PGLITE_DATA_DIR=.local/pglite
APP_URL=http://127.0.0.1:3000
# DATABASE_URL is only required for the future Neon deployment migration.
# Optional: server-only Vercel AI Gateway key. Never use NEXT_PUBLIC_ for this key.
AI_GATEWAY_API_KEY=
AI_MODEL=anthropic/claude-sonnet-4.6
